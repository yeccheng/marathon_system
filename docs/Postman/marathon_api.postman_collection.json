{
  "info": {
    "_postman_id": "a1b2c3d4-0000-4000-8000-marathon000001",
    "name": "马拉松赛事管理系统 API",
    "description": "对照《马拉松.pdf》设计文档生成的接口集合。基础地址 http://localhost:8080，5 大模块 22 个接口。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "模块1 赛事管理 /api/event",
      "item": [
        {
          "name": "1. 新增赛事",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "http://localhost:8080/api/event/add",
            "body": {"mode": "raw", "raw": "{\n  \"eventName\": \"2026西安国际马拉松\",\n  \"eventType\": 1,\n  \"eventDate\": \"2026-11-15\",\n  \"startLocation\": \"西安大明宫国家遗址公园\",\n  \"distanceKm\": 42.195,\n  \"quota\": 15000,\n  \"entryFee\": 200.00,\n  \"status\": 0\n}"}
          }
        },
        {
          "name": "2. 修改赛事",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "http://localhost:8080/api/event/update",
            "body": {"mode": "raw", "raw": "{\n  \"id\": 1,\n  \"eventName\": \"2026西安国际马拉松\",\n  \"eventType\": 1,\n  \"eventDate\": \"2026-11-15\",\n  \"startLocation\": \"西安大明宫国家遗址公园\",\n  \"distanceKm\": 42.195,\n  \"quota\": 16000,\n  \"entryFee\": 200.00,\n  \"status\": 0\n}"}
          }
        },
        {
          "name": "3. 分页查询赛事列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/api/event/list?pageNum=1&pageSize=10&eventName=西安&eventType=1&status=0&startDate=2026-10-01&endDate=2026-12-31"
          }
        },
        {
          "name": "4. 查询赛事详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/api/event/detail/1"
          }
        },
        {
          "name": "5. 删除赛事",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:8080/api/event/delete/2"
          }
        }
      ]
    },
